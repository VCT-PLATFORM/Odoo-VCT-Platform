<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="mail_template_timesheet_reminder" model="mail.template">
        <field name="name">Chấm công: Nhắc nhân viên nhập giờ</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="subject">Nhắc nhập bảng chấm công tuần trước</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">{{ object.work_email }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="description">Gửi cho nhân viên chưa nhập giờ công tuần trước</field>
        <field name="body_html" type="html">
<div style="margin:0px;padding:0px;font-size:13px;">
    <p>Chào <t t-out="object.name or ''">Nguyễn Văn A</t>,</p>
    <p>Tuần vừa rồi bạn chưa nhập giờ công nào. Vui lòng dành ít phút cập nhật bảng chấm công.</p>
    <p>Trân trọng.</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_validation_reminder" model="mail.template">
        <field name="name">Chấm công: Nhắc người duyệt</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">Có bảng chấm công chờ bạn duyệt</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="description">Gửi cho người duyệt khi còn dòng chấm công chưa duyệt</field>
        <field name="body_html" type="html">
<div style="margin:0px;padding:0px;font-size:13px;">
    <p>Chào <t t-out="object.name or ''">Quản lý</t>,</p>
    <p>Đang có <strong t-out="ctx.get('pending_count') or 0">5</strong> dòng chấm công của tuần trước chờ bạn duyệt.</p>
    <p>Trân trọng.</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="ir_cron_timesheet_reminder" model="ir.cron">
        <field name="name">Chấm công: Nhắc nhân viên nhập giờ</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_timesheet_users()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_validation_reminder" model="ir.cron">
        <field name="name">Chấm công: Nhắc người duyệt</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_timesheet_approvers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="False"/>
    </record>

</odoo>
