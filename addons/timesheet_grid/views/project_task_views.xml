<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_view_form_timer" model="ir.ui.view">
        <field name="name">project.task.view.form.timer</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="is_timer_running" invisible="1"/>
                <button name="action_timer_start" type="object" string="Bấm giờ" class="btn-primary"
                        invisible="is_timer_running or not allow_timesheets"/>
                <button name="action_timer_stop" type="object" string="Dừng &amp; ghi giờ công"
                        class="btn-primary" invisible="not is_timer_running"/>
            </header>
        </field>
    </record>

</odoo>
