<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_zalo_refresh" model="ir.cron">
        <field name="name">Zalo: gia hạn access token</field>
        <field name="model_id" ref="model_vct_zalo_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_tokens()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=12))"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
