<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_actions" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.erp.actions</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_fsm_task" type="object" string="Điều KTV"
                        groups="industry_fsm.group_fsm_user"/>
                <button name="action_create_refund" type="object" string="Hoàn tiền/Đổi trả"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_fsm_tasks" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="fsm_task_count == 0">
                    <field name="fsm_task_count" widget="statinfo" string="Việc KTV"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
