<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lưu trữ ticket đóng quá hạn (archive, KHÔNG xoá cứng). TẮT sẵn; chỉ chạy
         khi retention_months > 0 và cron được bật. -->
    <record id="ir_cron_retention" model="ir.cron">
        <field name="name">Bảo mật CSKH: lưu trữ ticket đóng quá hạn</field>
        <field name="model_id" ref="model_vct_cs_privacy_config"/>
        <field name="state">code</field>
        <field name="code">model._cron_apply_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(weeks=1))"/>
        <field name="active" eval="False"/>
    </record>
</odoo>
