<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_knowledge">
        <field name="name">Kiến thức</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_knowledge_user" model="res.groups">
        <field name="name">Người dùng</field>
        <field name="comment">Người dùng: đọc và viết bài trong kho kiến thức.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_knowledge"/>
    </record>

    <record id="group_knowledge_manager" model="res.groups">
        <field name="name">Quản trị viên</field>
        <field name="comment">Quản trị viên: thấy và quản lý mọi bài viết, kể cả bài riêng tư.</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('knowledge.group_knowledge_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_knowledge"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <!-- A private branch is visible only to whoever created its root.
             Rules of one group are OR-ed together, so this one must grant read
             ONLY: left with the default perms it would also hand out the write
             access the rule below is there to withhold. -->
        <record id="knowledge_article_rule_user" model="ir.rule">
            <field name="name">Bài viết: nhân viên: bỏ qua nhánh riêng tư của người khác</field>
            <field name="model_id" ref="model_knowledge_article"/>
            <field name="domain_force">[
                '|',
                ('root_article_id.internal_permission', '!=', 'none'),
                ('root_article_id.create_uid', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('knowledge.group_knowledge_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- A read-only branch stays read-only, private ones stay private. -->
        <record id="knowledge_article_rule_user_write" model="ir.rule">
            <field name="name">Bài viết: nhân viên: chỉ sửa nhánh cho phép ghi</field>
            <field name="model_id" ref="model_knowledge_article"/>
            <field name="domain_force">[
                '|',
                ('root_article_id.internal_permission', '=', 'write'),
                ('root_article_id.create_uid', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('knowledge.group_knowledge_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="knowledge_article_rule_manager" model="ir.rule">
            <field name="name">Bài viết: quản trị viên: thấy tất cả</field>
            <field name="model_id" ref="model_knowledge_article"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('knowledge.group_knowledge_manager'))]"/>
        </record>

    </data>

</odoo>
