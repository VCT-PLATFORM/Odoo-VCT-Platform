<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vct_cs_ai_log_view_list" model="ir.ui.view">
        <field name="name">vct.cs.ai.log.list</field>
        <field name="model">vct.cs.ai.log</field>
        <field name="arch" type="xml">
            <list string="Nhật ký AI CSKH" create="false"
                  decoration-warning="escalated">
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="question"/>
                <field name="answer"/>
                <field name="escalated"/>
                <field name="ticket_id"/>
            </list>
        </field>
    </record>

    <record id="vct_cs_ai_log_view_form" model="ir.ui.view">
        <field name="name">vct.cs.ai.log.form</field>
        <field name="model">vct.cs.ai.log</field>
        <field name="arch" type="xml">
            <form string="Nhật ký AI CSKH" create="false">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="partner_id"/>
                        <field name="ticket_id"/>
                        <field name="escalated"/>
                        <field name="config_id"/>
                    </group>
                    <separator string="Câu hỏi"/>
                    <field name="question" readonly="1"/>
                    <separator string="AI trả lời"/>
                    <field name="answer" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vct_cs_ai_log" model="ir.actions.act_window">
        <field name="name">Nhật ký AI CSKH</field>
        <field name="res_model">vct.cs.ai.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vct_cs_ai_log" name="Nhật ký AI CSKH"
        parent="helpdesk.menu_helpdesk_config" action="action_vct_cs_ai_log" sequence="71"/>
</odoo>
