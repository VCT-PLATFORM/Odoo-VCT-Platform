<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vct_cs_copilot_view_form" model="ir.ui.view">
        <field name="name">vct.cs.copilot.form</field>
        <field name="model">vct.cs.copilot</field>
        <field name="arch" type="xml">
            <form string="Copilot AI">
                <field name="mode" invisible="1"/>
                <field name="ticket_id" invisible="1"/>
                <group invisible="mode != 'rewrite'">
                    <field name="tone"/>
                    <field name="draft" placeholder="Dán nội dung bạn muốn AI viết lại..."/>
                    <button name="action_generate" type="object" string="Viết lại" class="btn-primary"/>
                </group>
                <separator string="Kết quả AI (xem/sửa trước khi gửi)"/>
                <field name="result" nolabel="1" placeholder="Bấm nút để AI tạo nội dung..."/>
                <footer>
                    <button name="action_post_reply" type="object" string="Chèn làm trả lời gửi khách"
                            class="btn-primary" invisible="mode == 'summarize' or not result"/>
                    <button name="action_generate" type="object" string="Tạo lại"
                            invisible="mode == 'rewrite'"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
