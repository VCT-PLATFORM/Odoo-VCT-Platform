<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="subscription_plan_view_list" model="ir.ui.view">
        <field name="name">vct.subscription.plan.list</field>
        <field name="model">vct.subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Gói thuê bao" editable="bottom">
                <field name="name"/>
                <field name="period_value"/>
                <field name="period_unit"/>
            </list>
        </field>
    </record>

    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Gói thuê bao</field>
        <field name="res_model">vct.subscription.plan</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
