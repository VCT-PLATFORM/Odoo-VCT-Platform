<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        account already implements the whole matching engine (account.move.line
        reconcile() / remove_move_reconcile()); what Community never wires up is a
        way to call it from a list. These two bindings put "Đối soát" and "Huỷ đối
        soát" in the cog menu of any journal-items list.
    -->
    <record id="action_reconcile_lines" model="ir.actions.server">
        <field name="name">Đối soát</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="state">code</field>
        <field name="code">
if len(records) &lt; 2:
    raise UserError("Hãy chọn ít nhất 2 dòng để đối soát với nhau.")
if len(records.account_id) != 1:
    raise UserError("Chỉ đối soát được các dòng trên cùng một tài khoản.")
if not records.account_id.reconcile:
    raise UserError("Tài khoản %s không cho phép đối soát. Bật 'Cho phép đối soát' trên tài khoản trước." % records.account_id.display_name)
records.reconcile()
        </field>
    </record>

    <record id="action_unreconcile_lines" model="ir.actions.server">
        <field name="name">Huỷ đối soát</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.remove_move_reconcile()</field>
    </record>

    <!-- Open items: what still needs matching, grouped by account -->
    <record id="action_open_items" model="ir.actions.act_window">
        <field name="name">Công nợ chưa đối soát</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[
            ('parent_state', '=', 'posted'),
            ('reconciled', '=', False),
            ('account_id.reconcile', '=', True),
            ('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')),
        ]</field>
        <field name="context">{'search_default_group_by_account': 1, 'create': 0, 'expand': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Không còn khoản nào chờ đối soát</p>
            <p>Chọn các dòng cần khớp với nhau rồi dùng menu bánh răng ⚙ → Đối soát.</p>
        </field>
    </record>

    <menuitem id="menu_open_items" action="action_open_items"
        parent="account.account_audit_control_menu" sequence="10"
        groups="account.group_account_readonly"/>

</odoo>
