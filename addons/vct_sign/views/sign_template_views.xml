<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sign_template_view_list" model="ir.ui.view">
        <field name="name">sign.template.list</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <list string="Mẫu ký">
                <field name="name"/>
                <field name="pdf_filename"/>
                <field name="request_count"/>
            </list>
        </field>
    </record>

    <record id="sign_template_view_form" model="ir.ui.view">
        <field name="name">sign.template.form</field>
        <field name="model">sign.template</field>
        <field name="arch" type="xml">
            <form string="Mẫu ký">
                <header>
                    <button name="action_new_request" type="object" string="Yêu cầu ký"
                            class="btn-primary" invisible="not pdf"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="request_count" widget="statinfo" string="Yêu cầu"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Vd: Hợp đồng lao động"/></h1>
                    </div>
                    <group>
                        <field name="pdf" filename="pdf_filename" widget="binary"/>
                        <field name="pdf_filename" invisible="1"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <separator string="Vùng ký (vị trí theo tỉ lệ 0–1 từ góc trên-trái)"/>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="item_type"/>
                            <field name="page"/>
                            <field name="pos_x"/>
                            <field name="pos_y"/>
                            <field name="width"/>
                            <field name="height"/>
                            <field name="label"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sign_template" model="ir.actions.act_window">
        <field name="name">Mẫu ký</field>
        <field name="res_model">sign.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
