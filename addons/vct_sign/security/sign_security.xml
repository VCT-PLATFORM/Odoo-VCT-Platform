<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sign_manager" model="res.groups">
        <field name="name">Ký điện tử: Quản trị</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="sign_request_rule_own" model="ir.rule">
        <field name="name">Yêu cầu ký: của tôi</field>
        <field name="model_id" ref="model_sign_request"/>
        <field name="domain_force">[('request_owner_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="sign_request_rule_manager" model="ir.rule">
        <field name="name">Yêu cầu ký: quản trị xem tất cả</field>
        <field name="model_id" ref="model_sign_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_sign_manager'))]"/>
    </record>
</odoo>
