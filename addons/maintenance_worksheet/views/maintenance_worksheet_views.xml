<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Worksheet Form View -->
        <record id="maintenance_worksheet_view_form" model="ir.ui.view">
            <field name="name">maintenance.worksheet.view.form</field>
            <field name="model">maintenance.worksheet</field>
            <field name="arch" type="xml">
                <form string="Bảng công tác bảo dưỡng">
                    <header>
                        <button name="action_done" string="Hoàn thành" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_draft" string="Trở về Nháp" type="object" invisible="state != 'done'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="request_id" readonly="1" options="{'no_open': False}"/>
                                <field name="template_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="date_signed" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Nội dung thực hiện" name="details">
                                <field name="line_ids" readonly="state == 'done'">
                                    <list editable="bottom" create="false" delete="false">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name" readonly="1"/>
                                        <field name="type" column_invisible="1"/>
                                        <field name="template_line_id" column_invisible="1"/>
                                        <field name="is_required" string="*" readonly="1" class="text-danger"/>
                                        
                                        <!-- Dynamic inputs based on question type -->
                                        <field name="value_checkbox" invisible="type != 'checkbox'"/>
                                        <field name="value_text" invisible="type != 'text'" placeholder="Nhập ghi nhận..."/>
                                        <field name="value_number" invisible="type != 'number'"/>
                                        <field name="value_option_id" 
                                               invisible="type != 'selection'"
                                               domain="[('line_id', '=', template_line_id)]" 
                                               options="{'no_create': True, 'no_open': True}"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Ký nhận bàn giao" name="signature">
                                <group>
                                    <group>
                                        <field name="signature" widget="signature" readonly="state == 'done'"/>
                                    </group>
                                    <group>
                                        <field name="signed_by" placeholder="Nhập tên người ký..." readonly="state == 'done'"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Worksheet Tree View -->
        <record id="maintenance_worksheet_view_tree" model="ir.ui.view">
            <field name="name">maintenance.worksheet.view.tree</field>
            <field name="model">maintenance.worksheet</field>
            <field name="arch" type="xml">
                <list string="Bảng công tác bảo dưỡng" create="false">
                    <field name="name"/>
                    <field name="request_id"/>
                    <field name="template_id"/>
                    <field name="signed_by"/>
                    <field name="date_signed"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
                </list>
            </field>
        </record>

    </data>
</odoo>
