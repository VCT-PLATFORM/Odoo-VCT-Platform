<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fb_post_view_list" model="ir.ui.view">
        <field name="name">vct.fb.post.list</field>
        <field name="model">vct.fb.post</field>
        <field name="arch" type="xml">
            <list string="Bài đăng FB">
                <field name="name"/>
                <field name="account_id"/>
                <field name="post_id"/>
                <field name="comment_count"/>
            </list>
        </field>
    </record>

    <record id="fb_post_view_form" model="ir.ui.view">
        <field name="name">vct.fb.post.form</field>
        <field name="model">vct.fb.post</field>
        <field name="arch" type="xml">
            <form string="Bài đăng FB">
                <header>
                    <button name="action_fetch_comments" type="object" string="Kéo bình luận"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_comments" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <field name="comment_count" widget="statinfo" string="Bình luận"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Vd: Bài live áo thun 20/7"/></h1>
                    </div>
                    <group>
                        <field name="account_id"/>
                        <field name="post_id" placeholder="ID bài đăng Facebook"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="message" placeholder="Nội dung bài đăng..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fb_post" model="ir.actions.act_window">
        <field name="name">Bài đăng FB</field>
        <field name="res_model">vct.fb.post</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
