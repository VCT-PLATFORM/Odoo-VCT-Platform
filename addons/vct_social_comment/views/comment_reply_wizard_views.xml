<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="comment_reply_wizard_view_form" model="ir.ui.view">
        <field name="name">vct.fb.comment.reply.wizard.form</field>
        <field name="model">vct.fb.comment.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Trả lời bình luận">
                <field name="comment_id" invisible="1"/>
                <field name="message" placeholder="Nhập nội dung trả lời gửi lên Facebook..."/>
                <footer>
                    <button name="action_send" type="object" string="Gửi trả lời" class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
