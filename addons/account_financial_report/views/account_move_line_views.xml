<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Trial balance: an aggregation of journal items per account, which the
         native pivot view already does correctly. -->
    <record id="account_move_line_view_pivot_trial_balance" model="ir.ui.view">
        <field name="name">account.move.line.view.pivot.trial.balance</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Bảng cân đối phát sinh" sample="0">
                <field name="account_id" type="row"/>
                <field name="debit" type="measure" string="Phát sinh Nợ"/>
                <field name="credit" type="measure" string="Phát sinh Có"/>
                <field name="balance" type="measure" string="Số dư"/>
            </pivot>
        </field>
    </record>

    <record id="action_trial_balance" model="ir.actions.act_window">
        <field name="name">Bảng cân đối phát sinh</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="account_move_line_view_pivot_trial_balance"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')), ('account_id.account_type', '!=', 'off_balance')]</field>
        <field name="context">{'search_default_posted': 1, 'create': 0}</field>
    </record>

    <record id="action_general_ledger" model="ir.actions.act_window">
        <field name="name">Sổ cái</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="search_view_id" ref="account.view_account_move_line_filter"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note'))]</field>
        <field name="context">{'search_default_posted': 1, 'search_default_group_by_account': 1, 'create': 0, 'expand': 1}</field>
    </record>

</odoo>
