<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_shipment" model="ir.sequence">
        <field name="name">Vận đơn</field>
        <field name="code">vct.shipment</field>
        <field name="prefix">VD</field>
        <field name="padding">5</field>
    </record>

    <!-- Mẫu nhà vận chuyển — nhập Token/Shop ID để dùng thật. -->
    <record id="carrier_ghn" model="vct.shipping.carrier" context="{'noupdate': True}">
        <field name="name">Giao Hàng Nhanh</field>
        <field name="provider">ghn</field>
    </record>
    <record id="carrier_ghtk" model="vct.shipping.carrier" context="{'noupdate': True}">
        <field name="name">Giao Hàng Tiết Kiệm</field>
        <field name="provider">ghtk</field>
    </record>
    <record id="carrier_viettelpost" model="vct.shipping.carrier" context="{'noupdate': True}">
        <field name="name">ViettelPost</field>
        <field name="provider">viettelpost</field>
    </record>
</odoo>
