<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vct_zalo_conversation_form_social" model="ir.ui.view">
        <field name="name">vct.zalo.conversation.form.social</field>
        <field name="model">vct.zalo.conversation</field>
        <field name="inherit_id" ref="vct_helpdesk_zalo.vct_zalo_conversation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_order" type="object" string="🛒 Chốt đơn"
                        class="btn-primary" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>

    <record id="vct_messenger_conversation_form_social" model="ir.ui.view">
        <field name="name">vct.messenger.conversation.form.social</field>
        <field name="model">vct.messenger.conversation</field>
        <field name="inherit_id" ref="vct_helpdesk_messenger.vct_messenger_conversation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_order" type="object" string="🛒 Chốt đơn"
                        class="btn-primary" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
