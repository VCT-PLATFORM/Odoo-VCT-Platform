<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_order_wizard_view_form" model="ir.ui.view">
        <field name="name">vct.social.order.wizard.form</field>
        <field name="model">vct.social.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Chốt đơn từ hội thoại">
                <group>
                    <field name="partner_id"/>
                    <field name="source"/>
                    <field name="delivery_note" placeholder="Địa chỉ giao, SĐT nhận, ghi chú..."/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="price_unit"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_order" type="object" string="Tạo đơn bán"
                            class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
