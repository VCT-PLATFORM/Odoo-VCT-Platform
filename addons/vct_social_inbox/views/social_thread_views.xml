<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_thread_view_list" model="ir.ui.view">
        <field name="name">vct.social.thread.list</field>
        <field name="model">vct.social.thread</field>
        <field name="arch" type="xml">
            <list string="Inbox hợp nhất" create="false" edit="false"
                  decoration-info="state=='bot'" decoration-muted="state=='closed'">
                <field name="channel" widget="badge"
                       decoration-primary="channel=='zalo'" decoration-info="channel=='messenger'"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="ticket_id" optional="show"/>
                <field name="last_message_at"/>
                <button name="action_chot_don" type="object" string="🛒 Chốt đơn"
                        class="btn-link" icon="fa-shopping-cart"/>
                <button name="action_open_source" type="object" string="Mở"
                        class="btn-link" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="social_thread_view_search" model="ir.ui.view">
        <field name="name">vct.social.thread.search</field>
        <field name="model">vct.social.thread</field>
        <field name="arch" type="xml">
            <search string="Inbox">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="zalo" string="Zalo" domain="[('channel','=','zalo')]"/>
                <filter name="messenger" string="Messenger" domain="[('channel','=','messenger')]"/>
                <separator/>
                <filter name="human" string="Nhân viên xử lý" domain="[('state','=','human')]"/>
                <filter name="bot" string="Bot" domain="[('state','=','bot')]"/>
                <group>
                    <filter name="group_channel" string="Kênh" context="{'group_by':'channel'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="social_thread_view_form" model="ir.ui.view">
        <field name="name">vct.social.thread.form</field>
        <field name="model">vct.social.thread</field>
        <field name="arch" type="xml">
            <form string="Hội thoại" create="false" edit="false">
                <header>
                    <button name="action_chot_don" type="object" string="🛒 Chốt đơn" class="btn-primary"/>
                    <button name="action_open_source" type="object" string="Mở hội thoại gốc"/>
                    <button name="action_open_ticket" type="object" string="Mở ticket"
                            invisible="not ticket_id"/>
                </header>
                <sheet>
                    <group>
                        <field name="channel"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="state"/>
                        <field name="ticket_id"/>
                        <field name="last_message_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_social_thread" model="ir.actions.act_window">
        <field name="name">Inbox hợp nhất</field>
        <field name="res_model">vct.social.thread</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có hội thoại</p>
            <p>Mọi hội thoại Zalo &amp; Messenger gộp về đây. Bấm "Chốt đơn" để bán ngay.</p>
        </field>
    </record>
</odoo>
