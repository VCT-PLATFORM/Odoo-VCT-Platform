<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_followup_level_view_list" model="ir.ui.view">
        <field name="name">account.followup.level.view.list</field>
        <field name="model">account.followup.level</field>
        <field name="arch" type="xml">
            <list string="Mức nhắc nợ" editable="bottom">
                <field name="delay" string="Quá hạn từ (ngày)"/>
                <field name="name"/>
                <field name="template_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_account_followup_level" model="ir.actions.act_window">
        <field name="name">Mức nhắc nợ</field>
        <field name="res_model">account.followup.level</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo mức nhắc nợ đầu tiên</p>
            <p>Mỗi mức ứng với một mốc số ngày quá hạn và một mẫu email gửi cho khách hàng.</p>
        </field>
    </record>

    <record id="res_partner_view_list_followup" model="ir.ui.view">
        <field name="name">res.partner.view.list.followup</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Nhắc nợ" create="0">
                <field name="display_name" string="Khách hàng"/>
                <field name="followup_level_id"/>
                <field name="followup_overdue_amount" sum="Tổng quá hạn"/>
                <field name="followup_next_date"/>
                <field name="currency_id" column_invisible="1"/>
                <button name="action_open_overdue_items" type="object" icon="fa-search"
                        title="Xem hoá đơn quá hạn"/>
                <button name="action_followup_send" type="object" icon="fa-envelope"
                        title="Gửi email nhắc nợ" invisible="not followup_level_id"/>
            </list>
        </field>
    </record>

    <!-- The overdue figures depend on today's date, so they are computed rather
         than stored and cannot be searched: resolve the customers in Python and
         pass them to the view as an id list. -->
    <record id="action_account_followup" model="ir.actions.server">
        <field name="name">Nhắc nợ khách hàng</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">action = model.action_followup_overview()</field>
    </record>

    <menuitem id="menu_account_followup" action="action_account_followup"
        parent="account.menu_finance_receivables" sequence="25"
        groups="account.group_account_invoice"/>
    <menuitem id="menu_account_followup_level" action="action_account_followup_level"
        parent="account.account_invoicing_menu" sequence="25"
        groups="account.group_account_manager"/>

</odoo>
