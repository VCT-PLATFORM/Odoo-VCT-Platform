<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Runs the delegated-task queue; action_run() _trigger()s it near-instantly. -->
    <record id="ir_cron_run_ai_tasks" model="ir.cron">
        <field name="name">Trợ lý AI: chạy việc được giao</field>
        <field name="model_id" ref="model_vct_ai_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Fires recurring schedules that are due. -->
    <record id="ir_cron_run_ai_schedules" model="ir.cron">
        <field name="name">Trợ lý AI: chạy việc định kỳ</field>
        <field name="model_id" ref="model_vct_ai_task_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_schedules()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
