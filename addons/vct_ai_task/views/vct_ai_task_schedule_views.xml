<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vct_ai_task_schedule_view_list" model="ir.ui.view">
        <field name="name">vct.ai.task.schedule.list</field>
        <field name="model">vct.ai.task.schedule</field>
        <field name="arch" type="xml">
            <list string="Việc định kỳ">
                <field name="name"/>
                <field name="user_id"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="next_run"/>
                <field name="last_run" optional="show"/>
                <field name="run_count" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="vct_ai_task_schedule_view_form" model="ir.ui.view">
        <field name="name">vct.ai.task.schedule.form</field>
        <field name="model">vct.ai.task.schedule</field>
        <field name="arch" type="xml">
            <form string="Việc định kỳ">
                <header>
                    <button name="action_run_now" type="object" string="Chạy ngay" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Lần chạy"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Đã tắt" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Vd: Tổng hợp công nợ mỗi sáng"/></h1>
                    </div>
                    <group>
                        <group string="Lặp lịch">
                            <label for="interval_number" string="Lặp mỗi"/>
                            <div class="o_row">
                                <field name="interval_number" class="oe_inline"/>
                                <field name="interval_type" class="oe_inline"/>
                            </div>
                            <field name="next_run"/>
                            <field name="last_run" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Cách chạy">
                            <field name="user_id"/>
                            <field name="use_tools"/>
                            <field name="run_count" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Nội dung giao việc"/>
                    <field name="instruction" placeholder="Việc AI làm mỗi lần chạy..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vct_ai_task_schedule" model="ir.actions.act_window">
        <field name="name">Việc định kỳ</field>
        <field name="res_model">vct.ai.task.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo lịch việc AI đầu tiên</p>
            <p>AI tự chạy việc theo lịch (mỗi sáng, mỗi tuần...) và lưu lại kết quả mỗi lần.</p>
        </field>
    </record>

    <menuitem id="menu_vct_ai_task_schedule" name="Việc định kỳ"
        parent="menu_vct_ai_task_root" action="action_vct_ai_task_schedule" sequence="20"/>

</odoo>
