<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_share_wizard_view_form" model="ir.ui.view">
        <field name="name">vct.social.share.wizard.form</field>
        <field name="model">vct.social.share.wizard</field>
        <field name="arch" type="xml">
            <form string="Chia sẻ sản phẩm">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="include_price"/>
                    <field name="custom_message" placeholder="Lời nhắn gửi kèm cho khách..."/>
                </group>
                <footer>
                    <button name="action_share" type="object" string="Gửi cho khách"
                            class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
