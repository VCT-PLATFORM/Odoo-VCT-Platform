<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Opt helpdesk.ticket into the website form builder, the same way
         website_project does it for tasks: users then drop a Form block on any
         page and pick "Gửi phiếu hỗ trợ" as its action. -->
    <record id="helpdesk.model_helpdesk_ticket" model="ir.model">
        <field name="website_form_key">create_ticket</field>
        <field name="website_form_default_field_id" ref="helpdesk.field_helpdesk_ticket__description"/>
        <field name="website_form_access">True</field>
        <field name="website_form_label">Gửi phiếu hỗ trợ</field>
    </record>

    <!-- Only these fields may be filled from a public form. Anything else a
         visitor posts is dropped: team_id and stage_id stay server-side so a
         visitor cannot file into another team or skip the first stage. -->
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>helpdesk.ticket</value>
        <value eval="[
            'name',
            'description',
            'partner_name',
            'partner_email',
        ]"/>
    </function>

</odoo>
