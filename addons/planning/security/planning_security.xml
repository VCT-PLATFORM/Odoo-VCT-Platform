<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_planning">
        <field name="name">Kế hoạch</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_planning_user" model="res.groups">
        <field name="name">Người dùng</field>
        <field name="comment">Người dùng: xem lịch đã công bố và nhận ca mở.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_planning"/>
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="comment">Quản lý: tạo, sửa và công bố ca làm việc.</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('planning.group_planning_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_planning"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">

        <!-- Employees see published shifts and anything still up for grabs;
             their own draft roster is not their business until it is published. -->
        <record id="planning_slot_rule_user" model="ir.rule">
            <field name="name">Ca làm việc: nhân viên: chỉ ca đã công bố và ca mở</field>
            <field name="model_id" ref="model_planning_slot"/>
            <field name="domain_force">[
                '|', ('state', '=', 'published'), ('employee_id', '=', False),
            ]</field>
            <field name="groups" eval="[(4, ref('planning.group_planning_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="planning_slot_rule_manager" model="ir.rule">
            <field name="name">Ca làm việc: quản lý: toàn quyền</field>
            <field name="model_id" ref="model_planning_slot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('planning.group_planning_manager'))]"/>
        </record>

        <record id="planning_slot_comp_rule" model="ir.rule">
            <field name="name">Ca làm việc: đa công ty</field>
            <field name="model_id" ref="model_planning_slot"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

    </data>

</odoo>
