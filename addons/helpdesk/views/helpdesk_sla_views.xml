<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_sla_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.view.list</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <list string="SLA Policies">
                <field name="name"/>
                <field name="team_id"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="time" widget="float_time" string="Within"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_sla_view_form" model="ir.ui.view">
        <field name="name">helpdesk.sla.view.form</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <form string="SLA Policy">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Urgent tickets answered within 2 hours"/></h1>
                    </div>
                    <group>
                        <group string="Applies to">
                            <field name="team_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Target">
                            <field name="stage_id" domain="['|', ('team_ids', '=', False), ('team_ids', 'in', team_id)]"/>
                            <label for="time"/>
                            <div class="d-flex align-items-center gap-2">
                                <field name="time" widget="float_time" class="oe_inline"/>
                                <span>of working hours after the ticket is submitted</span>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2" placeholder="Describe what this policy guarantees..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_sla_action" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">helpdesk.sla</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new SLA policy</p>
            <p>Set the time your teams commit to, and track the tickets that are at risk of missing it.</p>
        </field>
    </record>

    <record id="helpdesk_sla_status_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.view.list</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="arch" type="xml">
            <list string="SLA Status" create="0" delete="0" edit="0"
                  decoration-danger="status == 'failed'" decoration-success="status == 'reached'">
                <field name="sla_id"/>
                <field name="sla_stage_id"/>
                <field name="deadline" widget="remaining_days"/>
                <field name="reached_datetime"/>
                <field name="status"/>
            </list>
        </field>
    </record>

</odoo>
