<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_ticket" name="Portal My Home: tickets" customize_show="True" inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/helpdesk/static/src/img/tickets.svg'"/>
                <t t-set="title">Tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="text">Follow and close your support tickets</t>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs_ticket" name="Portal layout: ticket menu entry" inherit_id="portal.portal_breadcrumbs" priority="45">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'ticket'" t-attf-class="breadcrumb-item #{'active ' if not ticket else ''}">
                <a t-if="ticket" t-attf-href="/my/tickets?{{ keep_query() }}">Tickets</a>
                <t t-else="">Tickets</t>
            </li>
            <li t-if="ticket" class="breadcrumb-item active text-truncate">
                <span t-field="ticket.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_tickets" name="My Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Tickets</t>
            </t>
            <div t-if="not tickets" class="alert alert-info" role="alert">
                There are no tickets.
            </div>
            <t t-else="">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Subject</th>
                            <th class="text-end">Submitted on</th>
                            <th class="text-end">Assigned to</th>
                            <th class="text-end">Stage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="tickets" t-as="ticket">
                            <td>
                                <a t-attf-href="/my/tickets/#{ticket.id}"><span t-field="ticket.name"/></a>
                            </td>
                            <td class="text-end">
                                <span t-field="ticket.create_date" t-options="{'widget': 'date'}"/>
                            </td>
                            <td class="text-end">
                                <span t-if="ticket.sudo().user_id" t-field="ticket.sudo().user_id"/>
                                <span t-else="" class="text-muted">Unassigned</span>
                            </td>
                            <td class="text-end">
                                <span class="badge rounded-pill text-bg-light" t-field="ticket.stage_id"/>
                            </td>
                        </tr>
                    </tbody>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_ticket" name="My Ticket">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center gap-2">
                    <h5 class="mb-0 text-truncate"><span t-field="ticket.name"/></h5>
                    <span class="badge rounded-pill text-bg-primary" t-field="ticket.stage_id"/>
                </div>
                <div class="card-body">
                    <div t-if="ticket.description" t-field="ticket.description"/>
                    <p t-else="" class="text-muted">No description was provided for this ticket.</p>
                    <form t-if="ticket.team_id.allow_portal_close and not ticket.stage_id.fold"
                          t-attf-action="/my/tickets/#{ticket.id}/close" method="post" class="mt-4">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="access_token" t-att-value="access_token"/>
                        <button type="submit" class="btn btn-secondary">
                            <i class="fa fa-check me-1"/>My issue is solved
                        </button>
                    </form>
                </div>
            </div>
            <div class="mt-4">
                <t t-call="portal.message_thread">
                    <t t-set="token" t-value="ticket.access_token"/>
                </t>
            </div>
        </t>
    </template>

</odoo>
