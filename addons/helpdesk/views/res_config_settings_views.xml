<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.helpdesk</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Hỗ trợ" string="Hỗ trợ" name="helpdesk"
                     groups="helpdesk.group_helpdesk_manager">
                    <block title="Kênh tiếp nhận">
                        <setting help="Cho khách gửi phiếu hỗ trợ từ trang web.">
                            <field name="module_website_helpdesk"/>
                        </setting>
                    </block>
                    <block title="Tích hợp">
                        <setting help="Tạo lệnh sửa chữa thẳng từ phiếu hỗ trợ.">
                            <field name="module_helpdesk_repair"/>
                        </setting>
                    </block>
                    <block title="Cấu hình">
                        <setting string="Bộ phận hỗ trợ"
                                 help="Mỗi bộ phận có bí danh email, cách phân công và chính sách SLA riêng.">
                            <button name="%(helpdesk.helpdesk_team_action)d" type="action"
                                    string="Bộ phận" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                        <setting string="Giai đoạn"
                                 help="Giai đoạn xử lý phiếu, kèm email tự động và khảo sát hài lòng.">
                            <button name="%(helpdesk.helpdesk_stage_action)d" type="action"
                                    string="Giai đoạn" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                        <setting string="Chính sách SLA"
                                 help="Thời gian cam kết xử lý, tính theo giờ làm việc của bộ phận.">
                            <button name="%(helpdesk.helpdesk_sla_action)d" type="action"
                                    string="Chính sách SLA" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_helpdesk_configuration" model="ir.actions.act_window">
        <field name="name">Cài đặt</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'helpdesk'}</field>
    </record>

    <menuitem id="menu_helpdesk_settings" name="Cài đặt" parent="menu_helpdesk_config"
        sequence="0" action="action_helpdesk_configuration" groups="base.group_system"/>

</odoo>
