<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vct_messenger_conversation_view_list" model="ir.ui.view">
        <field name="name">vct.messenger.conversation.list</field>
        <field name="model">vct.messenger.conversation</field>
        <field name="arch" type="xml">
            <list string="Hội thoại Messenger">
                <field name="name"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="ticket_id"/>
                <field name="state" widget="badge"
                       decoration-info="state=='bot'" decoration-success="state=='human'"
                       decoration-muted="state=='closed'"/>
                <field name="last_message_at"/>
            </list>
        </field>
    </record>

    <record id="vct_messenger_conversation_view_form" model="ir.ui.view">
        <field name="name">vct.messenger.conversation.form</field>
        <field name="model">vct.messenger.conversation</field>
        <field name="arch" type="xml">
            <form string="Hội thoại Messenger">
                <header>
                    <button name="action_open_ticket" type="object" string="Mở ticket"
                            class="btn-primary" invisible="not ticket_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="psid"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="ticket_id"/>
                            <field name="last_message_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vct_messenger_conversation" model="ir.actions.act_window">
        <field name="name">Hội thoại Messenger</field>
        <field name="res_model">vct.messenger.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vct_messenger_conversation" name="Hội thoại Messenger"
        parent="helpdesk.menu_helpdesk_config" action="action_vct_messenger_conversation" sequence="63"/>
</odoo>
